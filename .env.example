# Public - accessible on client and server
NEXT_PUBLIC_BACKEND_API_URL=https://refactor.albrrak773.com
NEXT_PUBLIC_THIS_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.gdg-q.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_xxxxxx

# Error tracking (optional - Sentry no-ops if unset)
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only, for uploading readable source maps - never shipped to the browser
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Server-only - never expose to client
CLERK_SECRET_KEY=sk_xxxxxxx
# Shared secret used by the admin app to trigger a full data-cache reset via /api/revalidate
REVALIDATE_SECRET=your_shared_secret_here